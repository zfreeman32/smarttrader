# Repo-wide sample environment file
#
# Your real `.env` is gitignored. Copy values from this template into `.env`
# or export them in your shell/IDE environment.
#
# Note: the current repo mostly reads environment variables directly via
# `os.getenv(...)`; not every entrypoint auto-loads `.env` on its own.

# -----------------------------------------------------------------------------
# Live market data / collector
# Required for `python -m ote_live.scripts.run_live_collector` unless you pass
# `--api-key` explicitly.
# -----------------------------------------------------------------------------
FMP_API_KEY=your_financial_modeling_prep_api_key
OTE_LIVE_SOURCE_TIMEFRAME=5m
OTE_LIVE_COLLECTOR_POLL_INTERVAL_SECONDS=300
OTE_LIVE_STREAM_OUTPUTSIZE=2
OTE_LIVE_FINALIZED_BAR_GRACE_SECONDS=90
OTE_LIVE_SIGNAL_PROCESSING_DELAY_SECONDS=120
OTE_LIVE_CYCLE_FINALIZED_REFRESH_LOOKBACK_BARS=6
OTE_LIVE_REGISTRY_PATH=models/ote_model_registry_live_multifamily.json
OTE_LIVE_DASHBOARD_HOST=127.0.0.1
OTE_LIVE_DASHBOARD_PORT=8050
OTE_LIVE_DASHBOARD_URL=http://127.0.0.1:8050
OTE_LIVE_LONG_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/live_runtime_manifest_long.json
OTE_LIVE_SHORT_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/live_runtime_manifest_short.json
OTE_LIVE_OPEN_BROWSER=1

# -----------------------------------------------------------------------------
# Live email alerts
# Used by `ote_live.alerts.SmtpEmailTransport.from_environment()`
# and the live collector runtime when email recipients are supplied.
# -----------------------------------------------------------------------------
OTE_ALERT_EMAIL_SMTP_HOST=smtp.example.com
OTE_ALERT_EMAIL_SMTP_PORT=587
OTE_ALERT_EMAIL_SENDER=alerts@example.com
OTE_ALERT_EMAIL_SMTP_USERNAME=alerts@example.com
OTE_ALERT_EMAIL_SMTP_PASSWORD=replace_me
OTE_ALERT_EMAIL_SMTP_USE_TLS=1
OTE_ALERT_EMAIL_SMTP_TIMEOUT_SECONDS=30
OTE_LIVE_ALERT_EMAIL_RECIPIENTS=

# -----------------------------------------------------------------------------
# Live SMS alerts
# Used by `ote_live.alerts.TwilioSmsTransport.from_environment()`
# and the live collector runtime when SMS recipients are supplied.
#
# Provide either:
# - OTE_ALERT_SMS_FROM_NUMBER
# - OTE_ALERT_SMS_MESSAGING_SERVICE_SID
# You can keep the unused one blank.
#
# SMS recipients can also be email-to-text gateway addresses like
# `15555550123@vtext.com`. Those reuse the SMTP settings above and send
# text-only bodies with no screenshot attachments.
# -----------------------------------------------------------------------------
OTE_ALERT_SMS_FROM_NUMBER=+15555550123
OTE_ALERT_SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OTE_ALERT_SMS_AUTH_TOKEN=replace_me
OTE_ALERT_SMS_MESSAGING_SERVICE_SID=
OTE_ALERT_SMS_EMAIL_SUBJECT=
OTE_LIVE_ALERT_SMS_RECIPIENTS=
# -----------------------------------------------------------------------------
# Optional TensorFlow / CUDA runtime overrides
# Relevant for the training scripts under `model_training/classification/...`.
# Those scripts already set sane defaults internally, so these are only needed
# if you want to override behavior in your shell or IDE environment.
# -----------------------------------------------------------------------------
TF_CPP_MIN_LOG_LEVEL=2
CUDA_DEVICE_ORDER=PCI_BUS_ID
TF_FORCE_GPU_ALLOW_GROWTH=true
TF_GPU_ALLOCATOR=cuda_malloc_async
TF_DETERMINISTIC_OPS=1
CUDA_LAUNCH_BLOCKING=0
TF_ENABLE_AUTO_MIXED_PRECISION=0
TF_ENABLE_EAGER_CLIENT_STREAMING_ENQUEUE=false
TF_GPU_THREAD_MODE=gpu_private

# Linux-only / advanced CUDA path override. Leave blank on Windows unless you
# intentionally manage CUDA libraries through this variable.
LD_LIBRARY_PATH=

# -----------------------------------------------------------------------------
# CLI reminders
# These are not read from the environment today, but they are commonly used
# alongside the variables above when starting live services.
# -----------------------------------------------------------------------------
# Dashboard:
# python -m ote_live.scripts.run_live_dashboard
#
# Stable multifamily reevaluation bundle:
# python scripts/assemble_ote_multifamily_live_reports.py
# python scripts/run_ote_multifamily_live_cycle.py
#
# Collector:
# python -m ote_live.scripts.run_live_collector ^
#   --alert-email-recipients you@example.com ^
#   --alert-sms-recipients +15555550123
# Collector via email-to-text gateway:
# python -m ote_live.scripts.run_live_collector ^
#   --alert-sms-recipients 15555550123@vtext.com
