# Shared live dashboard store
OTE_LIVE_DB_PATH=ote_live/runtime_data/live_market_data.sqlite3
OTE_LIVE_DASHBOARD_HOST=127.0.0.1
OTE_LIVE_DASHBOARD_PORT=8050
OTE_LIVE_DASHBOARD_REFRESH_INTERVAL_MS=10000
OTE_LIVE_DASHBOARD_SIGNAL_LIMIT=120
OTE_LIVE_DASHBOARD_MODEL_CHART_LOOKBACK_HOURS=24
OTE_LIVE_DASHBOARD_URL=http://127.0.0.1:8050

# Existing OTE collector defaults
FMP_API_KEY=replace_me
OTE_LIVE_ASSET=EURUSD
OTE_LIVE_SOURCE_TIMEFRAME=5m
OTE_LIVE_LONG_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/live_runtime_manifest_long.json
OTE_LIVE_SHORT_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/live_runtime_manifest_short.json

# Shared alert recipients. The OTE collector uses these directly; the FRVP-only
# and shared ES (FRVP + ICT) collectors inherit them unless a family-specific
# override below is supplied.
OTE_LIVE_ALERT_EMAIL_RECIPIENTS=
OTE_LIVE_ALERT_SMS_RECIPIENTS=
FRVP_LIVE_ALERT_EMAIL_RECIPIENTS=
FRVP_LIVE_ALERT_SMS_RECIPIENTS=
ES_LIVE_ALERT_EMAIL_RECIPIENTS=
ES_LIVE_ALERT_SMS_RECIPIENTS=

# FRVP shadow live defaults
FRVP_LIVE_ASSET=ES
FRVP_LIVE_TIMEFRAME=5m
FRVP_LIVE_DATA_SUPPLIER=IBKR
FRVP_LIVE_DB_PATH=ote_live/runtime_data/live_market_data.sqlite3
FRVP_LIVE_REGISTRY_PATH=models/frvp_es_shadow_live_registry_20260721.json
FRVP_LIVE_LONG_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/frvp_es_shadow_20260721/live_runtime_manifest_long.json
FRVP_LIVE_SHORT_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/frvp_es_shadow_20260721/live_runtime_manifest_short.json
FRVP_LIVE_SERVICE_NAME=frvp-live-signal-service
FRVP_LIVE_LOG_FILE=ote_live/runtime_data/logs/frvp_live_signal_service.log
FRVP_LIVE_HEARTBEAT_FILE=ote_live/runtime_data/health/frvp_live_signal_service_heartbeat.json

# ICT controlled paper-signal defaults. Only long-meta is active; all other ICT
# models remain shadow candidates in this immutable bundle.
ICT_LIVE_ASSET=ES
ICT_LIVE_TIMEFRAME=5m
ICT_LIVE_DATA_SUPPLIER=IBKR
ICT_LIVE_DB_PATH=ote_live/runtime_data/live_market_data.sqlite3
ICT_LIVE_REGISTRY_PATH=models/ict_es_paper_signal_registry_20260813.json
ICT_LIVE_LONG_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/ict_es_paper_signal_20260813/live_runtime_manifest_long.json
ICT_LIVE_SHORT_RUNTIME_MANIFEST_PATH=ote_live/runtime_manifests/ict_es_paper_signal_20260813/live_runtime_manifest_short.json
ES_LIVE_ALL_MODELS_ACTIVE=false
ICT_PAPER_SIGNAL_TRIAL_ENABLED=false

# IBKR ES futures config
IBKR_ENABLED=true
IBKR_HOST=127.0.0.1
# IB Gateway paper default. Use 7497 for a default TWS paper session.
IBKR_PORT=4002
IBKR_CLIENT_ID=21
IBKR_ACCOUNT_MODE=paper
IBKR_MARKET_DATA_TYPE=live
IBKR_ALLOW_DELAYED_FALLBACK=false

IBKR_ES_SYMBOL=ES
IBKR_ES_SECURITY_TYPE=FUT
IBKR_ES_EXCHANGE=CME
IBKR_ES_CURRENCY=USD
IBKR_ES_MULTIPLIER=50
IBKR_ES_TRADING_CLASS=ES

IBKR_ES_BAR_SIZE=5 mins
IBKR_ES_HISTORY_DURATION=2 D
IBKR_ES_USE_RTH=false

IBKR_ES_ROLL_POLICY=cme_calendar
IBKR_ES_ROLL_TIME_ET=09:30
# Optional validated manual overrides; leave blank for automatic discovery/roll:
IBKR_ES_MANUAL_CONID=
IBKR_ES_MANUAL_CONTRACT_MONTH=

IBKR_STALE_QUOTE_SECONDS=15
IBKR_STALE_BAR_SECONDS=420
IBKR_DELAYED_HISTORY_REFRESH_SECONDS=240
IBKR_RECONNECT_INITIAL_SECONDS=2
IBKR_RECONNECT_MAX_SECONDS=60
